---
const links = [
  { label: 'GitHub', href: 'https://github.com/hoadinhmai' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/hoadinhmai' },
];
---

<section style="margin-bottom:3rem;">
  <h1 style="font-size:2.25rem;font-weight:700;">Hoa Mai</h1>
  <p style="color:var(--muted);margin-top:0.35rem;">Cloud Engineer</p>
  <p style="margin-top:1rem;display:flex;gap:0.5rem;">
    {links.map((l) => (
      <a class="pill" href={l.href}>{l.label}</a>
    ))}
  </p>
</section>
