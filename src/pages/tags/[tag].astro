---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { filterPublished, sortByDateDesc, getAllTags } from '../../utils/posts';

export async function getStaticPaths() {
  const published = filterPublished(await getCollection('blog'));
  return getAllTags(published).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: sortByDateDesc(published.filter((p) => p.data.tags.includes(tag))),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Hoa Mai`}>
  <h1 style="font-size:2rem;margin-bottom:0.5rem;">#{tag}</h1>
  <p class="mono" style="margin-bottom:2rem;">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
  {posts.map((post) => (
    <PostCard
      slug={post.id}
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      tags={post.data.tags}
    />
  ))}
  <p><a href="/tags" class="mono">← All tags</a></p>
</BaseLayout>
