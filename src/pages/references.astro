---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceCard from '../components/ReferenceCard.astro';

const refs = await getCollection('references');
// Not Map.groupBy: CI builds on Node 20, which lacks it.
const byCategory = new Map<string, typeof refs>();
for (const ref of refs) {
  byCategory.set(ref.data.category, [...(byCategory.get(ref.data.category) ?? []), ref]);
}
const categories = [...byCategory.keys()].sort();
---

<BaseLayout title="References | Hoa Mai" description="Reference architectures and best practices worth bookmarking.">
  <h1 style="font-size:2rem;margin-bottom:0.5rem;">References</h1>
  <p style="color:var(--muted);margin-bottom:2rem;">Reference architectures and best practices I keep coming back to.</p>
  {categories.map((category) => (
    <section style="margin-bottom:2.5rem;">
      <h2 class="mono" style="font-size:0.8rem;letter-spacing:0.08em;color:var(--faint);text-transform:uppercase;margin-bottom:1rem;">{category}</h2>
      {byCategory.get(category)!.map((ref) => <ReferenceCard {...ref.data} />)}
    </section>
  ))}
</BaseLayout>
